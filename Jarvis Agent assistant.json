    {
      "parameters": {
        "jsCode": "// EDIT: put your Telegram user ID between the quotes\nconst ALLOWED = ['YOUR_TELEGRAM_USER_ID'];\nconst j = $input.first().json;\n\n// Local voice script (webhook): body = { text: \"...\" }\nif (j.update_id === undefined) {\n  const b = j.body || {};\n  return [{ json: { source: 'webhook', allowed: true, chatId: null, sessionId: 'voice-main', text: String(b.text || '').trim() } }];\n}\n\n// Telegram\nconst msg = j.message || {};\nconst from = msg.from || {};\nconst text = String(msg.text || msg.caption || '').trim();\nreturn [{ json: {\n  source: 'telegram',\n  allowed: ALLOWED.includes(String(from.id)) && !!text,\n  chatId: msg.chat ? msg.chat.id : null,\n  sessionId: 'tg-' + (msg.chat ? msg.chat.id : 'unknown'),\n  text\n} }];"
      },
